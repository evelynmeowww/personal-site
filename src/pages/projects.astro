---
import CenteredLayout from '../layouts/CenteredLayout.astro';
import Link from '../components/Link.astro';
---

<CenteredLayout>
  <header is-="column" gap-="1" space-="px:1">
    <h1 autofocus>Projects</h1>
    <p>Here are some projects I'm currently working on!</p>

    <div id="projects" box-="square" shear-="top">
      <row>
        <span is-="badge" variant-="background0">
          Projects
        </span>
      </row>

      <column space-="px:1 pb:1" is-="typography-block">
        <Link href="https://themurderrproject.com">
          <code>The Murd[ERR] Project</code>
          <span>- A ten-player social deduction game in Minecraft</span>
        </Link>

        <Link href="https://temper-mc.com">
          <code>Temper</code>
          <span>- A Minecraft server implementation in Rust</span>
        </Link>
        
        <Link href="https://git.evelynmeow.com/axi">
          <code>axi</code>
          <span>- A modern Minecraft game engine based on Kotlin Coroutines</span>
        </Link>

        <Link href="https://github.com/evelynmeowww/packed">
          <code>packed</code>
          <span>- A Minecraft resource pack compiler for Kotlin</span>
        </Link>

        <Link href="https://github.com/mcbrawls/inject">
          <code>inject</code>
          <span>- A library for Minecraft servers to make Netty injection easier</span>
        </Link>
      </column>
    </div>
  </header>
</CenteredLayout>

