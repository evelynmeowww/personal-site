---
import Link from '../components/Link.astro';

const { showHome } = Astro.props;
---

<div id="links" box-="square" shear-="top">
  <row>
    <span is-="badge" variant-="background0">
      Links
    </span>
  </row>
  <column space-="px:1 pb:1" is-="typography-block">
    {showHome &&
      <Link href="/">
        <code id="nf">&#xf46d</code>
        <span>Home</span>
      </Link>
    }

    <Link href="/about">
      <code id="nf">&#xf15c</code>
      <span>About me</span>
    </Link>

    <Link href="/projects">
      <code id="nf">&#xebeb</code>
      <span>Projects</span>
    </Link>

    <Link href="/contact">
      <code id="nf">&#xf05b8</code>
      <span>Contact</span>
    </Link>

    <Link href="https://github.com/evelynmeowww" target="_blank">
      <code id="nf">&#xe702</code>
      <span>Git</span>
    </Link>

    <Link href="https://ko-fi.com/evelynmeow" target="_blank">
      <code id="nf">&#xf01aa</code>
      <span>Ko-Fi</span>
    </Link>
  </column>
</div>

<style>
#nf {
  font-family: "JetBrains Mono", Menlo, Monaco, monospace, "Symbols Nerd Font";
}
</style>
